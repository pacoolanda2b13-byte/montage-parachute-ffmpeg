# ─── Claude Code / IDE ────────────────────
.claude/
.vscode/
.idea/

# ─── Archives / dumps ─────────────────────
*.zip
*.7z
*.rar

# ─── Exception : garder le deck de démo dans docs/
!docs/*.pptx

# ─── Generator script pour le PPTX (pas dans repo) ──
generate_pptx.js

# ─── OS ───────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Python ───────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ─── Secrets ──────────────────────────────
.env
*.pem
*.key
**/google_credentials.json
**/*_token.json

# ─── Vidéos / assets lourds ───────────────
**/sources/*.mp4
**/sources/*.MP4
**/sources/*.mov
**/sources/*.MOV
**/output/*.mp4
**/output/*.MP4
**/logs/*.log
**/assets/music/*.mp3
**/assets/music/*.wav

# Mais garder les .gitkeep
!**/.gitkeep

# ─── Base de données ──────────────────────
*.db
*.sqlite
*.sqlite3

# ─── Config locale ────────────────────────
skydive_pro/config/config.yaml

# ─── Artifacts ad-hoc générés en local ────
skydive_pro/bench_results_*.json
skydive_pro/output/*.pdf
skydive_pro/output/generate_*.py
skydive_pro/scripts/build_*.py
skydive_pro/scripts/concat_clips.py
skydive_pro/tests/wetransfer_*/

