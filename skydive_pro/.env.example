# =========================================================
#  SkyDive Pro — Configuration d'environnement
#  Copier ce fichier en .env et renseigner tes clés
# =========================================================

# ─── Serveur Flask ──────────────────────────────────────
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false
API_KEY=change-moi-pour-une-longue-chaine-aleatoire

# ─── Dossiers ───────────────────────────────────────────
DOSSIER_SOURCES=./sources
DOSSIER_SORTIE=./output
DOSSIER_ASSETS=./assets
DOSSIER_LOGS=./logs

# ─── Base de données ────────────────────────────────────
DATABASE_URL=sqlite:///./db/skydive.db

# =========================================================
#  IA — Stratégie Hybride (principale : Gemini gratuit)
# =========================================================

# ─── Google Gemini (GRATUIT jusqu'à 1500 req/jour) ──────
# Obtenir une clé : https://aistudio.google.com/app/apikey
GEMINI_API_KEY=ta-cle-gemini-ici
GEMINI_MODEL=gemini-flash-latest

# ─── Anthropic Claude (OPTIONNEL - fallback premium) ────
# Obtenir une clé : https://console.anthropic.com
# Laisser vide pour désactiver Claude (tout passera par Gemini)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-6

# ─── Contrôle du budget API ─────────────────────────────
# Coupe l'accès API si les coûts mensuels dépassent ce montant (en €)
BUDGET_API_MAX_EUR=50
# Quand activer le fallback Claude : jamais | scenes_ambigues | toutes
MODE_IA=scenes_ambigues

# =========================================================
#  Livraison
# =========================================================

# ─── Google Drive + Gmail (OAuth) ───────────────────────
# Télécharger credentials.json depuis https://console.cloud.google.com
# puis placer dans config/google_credentials.json
GOOGLE_CREDENTIALS_PATH=./config/google_credentials.json
DRIVE_FOLDER_ID_SOURCES=
DRIVE_FOLDER_ID_OUTPUT=

# ─── Email d'envoi ──────────────────────────────────────
EMAIL_FROM=dropzone@example.fr
EMAIL_NOM_EXPEDITEUR=Skydive Adventure

# ─── Twilio SMS (OPTIONNEL) ─────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=

# =========================================================
#  Branding dropzone (pourrait aussi aller dans config.yaml)
# =========================================================
DROPZONE_NOM=Skydive Adventure
DROPZONE_SITE=https://skydive-adventure.fr
DROPZONE_LOGO=./assets/branding/logo_dropzone.png

# =========================================================
#  Encodage vidéo
# =========================================================
# libx264 (CPU, compatible partout) | h264_amf (AMD GPU) | h264_nvenc (NVIDIA) | h264_videotoolbox (Mac)
ENCODEUR_VIDEO=h264_amf
